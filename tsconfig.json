{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "lib": ["ES2021", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
