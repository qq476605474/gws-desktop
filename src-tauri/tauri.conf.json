{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GWS",
  "version": "1.0.0",
  "identifier": "io.github.qq476605474.gwsdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run bundle:cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GWS",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb"
    ],
    "resources": ["resources/*"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/desktop-template.desktop"
      }
    }
  }
}
