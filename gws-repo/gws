#!/usr/bin/env bash
# gws — git workspace manager（git work space，用 Git 管理工作空间）
# 一个需求 = 一个工作区 = 一组 worktree，互不干扰，永不切分支。
#
# 本脚本独立于任何 hub 目录，可放在 ~/.local/bin/ 直接分发使用。
# hub 由 gws init 创建，根目录放 .gws-hub 标记文件供 gws 向上定位。
# 更新：gws update（从 GitHub 拉取最新版本，需 curl；可配 GWS_UPDATE_URL 覆盖）。
set -uo pipefail

GWS_VERSION="0.4.2"
GWS_REPO="qq476605474/gws"
GWS_MAINTAINER="qq476605474"   # 只有该 GitHub 账号能执行 gws release（发布新版本）
GWS_DEFAULT_URL="https://raw.githubusercontent.com/qq476605474/gws/main/gws"
GWS_UPDATE_URL="${GWS_UPDATE_URL:-$GWS_DEFAULT_URL}"

R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; D=$'\e[2m'; N=$'\e[0m'
die()  { echo "${R}✗${N} $*" >&2; exit 1; }
warn() { echo "${Y}⚠${N} $*" >&2; }
ok()   { echo "${G}✓${N} $*"; }
info() { echo "${B}▸${N} $*"; }

# 当前脚本的绝对路径（供 update 自替换）
gws_self_path() {
  local p="$0"; [ "$p" = "gws" ] && p="$(command -v gws)"
  case "$p" in
    /*) echo "$p";;
    *)  echo "$(cd "$(dirname "$p")" 2>/dev/null && pwd)/$(basename "$p")";;
  esac
}

# ══ hub 定位 ══════════════════════════════════════════════════════════
# 规则：--hub <路径> 显式指定 > 从 $PWD 向上找 .gws-hub 标记文件。
# init/migrate 可在任意目录执行；其余命令必须在 hub 内（或带 --hub）。
HUB=""; REPOS=""; ENVS=""; WS=""; DOCS=""

find_hub() {
  local d="${1:-$PWD}"
  while [ "$d" != "/" ]; do
    [ -f "$d/.gws-hub" ] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

# 设定 HUB 及其派生路径
set_hub() {
  HUB="$(cd "$1" && pwd)"
  REPOS="$HUB/repos"; ENVS="$HUB/envs"; WS="$HUB/ws"; DOCS="$HUB/docs"
}

# 需要 hub 的命令统一先调它
require_hub() {
  [ -n "$HUB" ] && return 0
  local h; h="$(find_hub)" || die "不在任何 hub 目录内。
     ${D}创建新 hub:   ${B}gws init <目录>${N}
     ${D}或 cd 进已有 hub 目录再执行，也可显式指定: ${B}gws <命令> --hub <hub路径>${N}"
  set_hub "$h"
}

# ── 环境列表：直接看 envs/ 下有哪些目录（每个 hub 各自独立，无需配置）──
# gws env add/rm 即增删这些目录；新增仓库由 gws sync 补建各环境的 worktree。
all_envs() { (cd "$ENVS" 2>/dev/null && ls -d */ 2>/dev/null | sed 's#/##'); }

# ── 主干名探测：有 main 用 main，否则 master，再兜底查询远程默认分支 ────
main_branch() {
  git -C "$REPOS/$1" rev-parse --verify -q origin/main >/dev/null 2>&1 && { echo main; return 0; }
  git -C "$REPOS/$1" rev-parse --verify -q origin/master >/dev/null 2>&1 && { echo master; return 0; }
  # 主干被改名（如 develop）→ 查远程 HEAD；仅在前两种都不存在时才走网络
  git -C "$REPOS/$1" ls-remote --symref origin HEAD 2>/dev/null \
    | sed -n 's/^ref: refs\/heads\/\([^[:space:]]*\)[[:space:]]*HEAD$/\1/p' | head -1
}
has_remote() { git -C "$REPOS/$1" rev-parse --verify -q "origin/$2" >/dev/null 2>&1; }
all_repos()  { (cd "$REPOS" && ls -d */ 2>/dev/null | sed 's#/##'); }

# 清理各仓库僵尸 worktree 元数据（手工删目录 / 中断残留），
# 防止后面的 worktree add 撞上 "already exists" / 占用同名路径
prune_all_repos() {
  local p; for p in $(all_repos); do git -C "$REPOS/$p" worktree prune 2>/dev/null; done
}

# 工作区/分支名称合法性：拒绝空格、斜杠、`.` 开头、`..`（防路径穿越）；
# 允许中文等 Unicode 与字母数字、点、下划线、连字符
validate_ws_name() {
  local n="$1" what="$2"
  case "$n" in
    ''|*[[:space:]/]*) die "$what 名称非法: '$n'  ${D}(不能为空、含空格或斜杠)${N}";;
    .*|*..*) die "$what 名称非法: '$n'  ${D}(不能以 . 开头或包含 '..')${N}";;
  esac
}

# ── 定位当前工作区：从 $PWD 向上找 .workspace.json ────────────────────
find_ws() {
  local d="${1:-$PWD}"
  while [ "$d" != "/" ]; do
    [ -f "$d/.workspace.json" ] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
cur_ws() { find_ws || die "不在任何工作区内（当前目录及上级均无 .workspace.json）。
   ${D}工作区命令需在 ws/<需求名>/ 内执行。若刚手工删除过模块目录，可在该处执行 ${B}gws drop${N} 清理残留${N}"; }

# 无依赖读 json 标量 / 数组
jget() { sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }
# 只取 key 所在行 [ ... ] 内的元素，避免吞掉后续字段
jarr() {
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p" "$1" \
    | head -1 | grep -o '"[^"]*"' | tr -d '"'
}

# ══════════════════════════════════════════════════════════════════════
cmd_new() {
  local name="" title="" mods="" from="" branch="" prefix="feature"
  name="${1:-}"; shift || true
  [ -n "$name" ] || die "用法: gws new <名称> [--modules a,b,c] [--from 基线[,基线]...] [--title \"中文标题\"] [--prefix hotfix] [--branch <分支名>]"
  validate_ws_name "$name" "工作区"
  while [ $# -gt 0 ]; do
    case "$1" in
      --modules|-m) mods="$2"; shift 2;;
      --from|-f)    from="${from:+$from,}${2}"; shift 2;;   # 可多次指定、可逗号分隔，顺序即优先级（主干自动兜底）
      --title|-t)   title="$2"; shift 2;;
      --branch|-b)  branch="$2"; shift 2;;
      --prefix|-p)  prefix="$2"; shift 2;;   # 换前缀但保留 <前缀>-日期-<名称> 结构
      *) die "未知参数: $1";;
    esac
  done
  # --prefix 只影响默认分支名；显式 --branch 优先级更高
  case "$prefix" in
    *[!a-zA-Z]*|"") die "--prefix 只能是英文字母: $prefix  ${D}(如 feature/hotfix/release)${N}";;
  esac
  if [ -z "$mods" ]; then
    mods="$(cd "$REPOS" && ls -d */ 2>/dev/null | sed 's#/##' | paste -sd ',' -)"
    [ -n "$mods" ] || die "repos/ 下没有任何仓库可建工作区"
    info "未指定 --modules，默认全部仓库: ${mods//,/ }"
  fi
  local dir="$WS/$name"
  [ -e "$dir" ] && die "工作区已存在: $dir  ${D}(改名为: gws rename $name <新名>；删除重建: gws rm $name)${N}"
  branch="${branch:-$prefix-$(date +%Y%m%d)-$name}"
  title="${title:-$name}"
  local docdir="$(date +%Y-%m-%d)-$name"

  # ── 预检：全部模块通过才开始创建 ──────────────────────────────────
  # 避免「部分仓库建成、部分失败」的半残工作区。分支已存在于远程时，
  # 本地 worktree add -b 仍会成功，却建出与远程同名而内容无关的分支，
  # 直到 gws push 才暴露分叉 —— 因此必须在动手前查远程。
  info "预检 ${branch}"
  prune_all_repos   # 清掉手工删目录/中断残留的 worktree 元数据，避免 add 撞已存在路径
  local pre_remote=() pre_local=() pre_norepo=()
  local IFS=','; local -a MS_CHK; read -ra MS_CHK <<< "$mods"; unset IFS
  for m in ${MS_CHK[@]+"${MS_CHK[@]}"}; do
    m="$(echo "$m" | xargs)"; [ -n "$m" ] || continue
    if [ ! -d "$REPOS/$m" ]; then pre_norepo+=("$m"); continue; fi
    git -C "$REPOS/$m" fetch --prune -q origin 2>/dev/null
    git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1 \
      && pre_remote+=("$m")
    git -C "$REPOS/$m" show-ref --verify -q "refs/heads/$branch" \
      && pre_local+=("$m")
  done

  if [ ${#pre_norepo[@]} -gt 0 ]; then
    echo; echo "${R}以下仓库不存在于 repos/:${N}"
    printf "  ${R}✗${N} %s\n" "${pre_norepo[@]}"
    echo; echo "  ${D}添加仓库: ${B}gws repo add <git地址>${N}   查看已有: ${B}gws repo ls${N}"
    return 1
  fi
  if [ ${#pre_remote[@]} -gt 0 ]; then
    echo; echo "${R}分支 $branch 已存在于远程:${N}"
    printf "  ${R}✗${N} %s\n" "${pre_remote[@]}"
    echo
    echo "  ${D}若这是他人已创建的需求，改用: ${B}gws get $branch${N}"
    echo "  ${D}若要另建新需求，换个名称或指定分支: ${B}gws new <别的名称>${N} / ${B}--branch <分支名>${N}"
    return 1
  fi
  if [ ${#pre_local[@]} -gt 0 ]; then
    echo; echo "${R}分支 $branch 已存在于本地:${N}"
    printf "  ${R}✗${N} %s\n" "${pre_local[@]}"
    echo
    echo "  ${D}可能是此前删目录未清理干净。查看: ${B}gws ls${N}"
    echo "  ${D}确认无用后删除: ${B}git -C repos/<仓库> branch -D $branch${N}"
    return 1
  fi

  mkdir -p "$dir" "$DOCS/$docdir"
  local created=() failed=()
  IFS=',' read -ra MS <<< "$mods"
  for m in "${MS[@]}"; do
    m="$(echo "$m" | xargs)"; [ -n "$m" ] || continue
    [ -d "$REPOS/$m" ] || { failed+=("$m: 仓库不存在"); continue; }
    local base note=""
    if [ -n "$from" ]; then
      # 基线链按优先级解析：逐个来源检查该模块是否有对应分支，
      # 第一个命中的作为基线；全不命中自动兜底主干（无需在链里写主干）。
      local out; out="$(resolve_chain_base "$m" "$from")"
      base="${out%%$'\n'*}"
      note="${out#*$'\n'}"; [ "$note" = "$out" ] && note=""
    else
      base="origin/$(main_branch "$m")"
    fi
    git -C "$REPOS/$m" rev-parse --verify -q "$base" >/dev/null 2>&1 \
      || { failed+=("$m: 基线 $base 不存在"); continue; }
    if git -C "$REPOS/$m" worktree add -q -b "$branch" "$dir/$m" "$base" 2>/dev/null; then
      # 从 origin/<主干> 建分支时 git 会自动把上游设成主干 —— 必须解除，
      # 否则 IDE 的 Push 会推向 origin/main 而不是 feature 分支
      git -C "$dir/$m" branch --unset-upstream 2>/dev/null
      created+=("$m")
      if [ -n "$note" ]; then
        echo "  ${G}✓${N} $m  ${D}← $base${N} ${Y}($note)${N}"
      else
        echo "  ${G}✓${N} $m  ${D}← $base${N}"
      fi
    else
      failed+=("$m: worktree 创建失败(分支 $branch 可能已存在)")
    fi
  done
  # 预检已排除绝大多数失败原因；此处仍失败（基线缺失等）则整体回滚，
  # 不留下模块残缺的半成品工作区。
  if [ ${#failed[@]} -gt 0 ]; then
    echo; echo "${R}以下模块创建失败:${N}"
    printf "  ${R}✗${N} %s\n" "${failed[@]}"
    echo; info "回滚已创建的 ${#created[@]} 个模块"
    for m in ${created[@]+"${created[@]}"}; do
      git -C "$REPOS/$m" worktree remove --force "$dir/$m" 2>/dev/null
      git -C "$REPOS/$m" branch -D "$branch" >/dev/null 2>&1
    done
    rm -rf "$dir"; rmdir "$DOCS/$docdir" 2>/dev/null
    die "工作区未创建（已回滚，无残留）"
  fi
  [ ${#created[@]} -gt 0 ] || { rmdir "$dir" 2>/dev/null; rmdir "$DOCS/$docdir" 2>/dev/null; die "没有任何模块创建成功"; }

  ln -sfn "../../docs/$docdir" "$dir/docs"
  local mj; mj=$(printf '"%s", ' "${created[@]}"); mj="[${mj%, }]"
  cat > "$dir/.workspace.json" <<EOF
{
  "name": "$name",
  "title": "$title",
  "branch": "$branch",
  "base": "${from:-主干}",
  "created": "$(date +%Y-%m-%d)",
  "stage": "dev",
  "modules": $mj,
  "docs": "$docdir",
  "merged": { "dev": null, "pre": null, "main": null }
}
EOF
  cat > "$dir/CLAUDE.md" <<EOF
# $title

> 工作区 \`$name\` · 分支 \`$branch\` · 基线 ${from:-主干}

## 涉及模块
$(printf -- "- %s\n" "${created[@]}")

## 约定
- 本目录下**只有**本需求会改动的模块，检索范围即为改动范围。
- 每个模块目录固定在 \`$branch\` 分支，**不要切分支**。
- 合并 dev/pre 用 \`gws merge dev\`，不要手工在此目录合。
- 文档写在 \`docs/\`（软链到 \`docs/$docdir/\`），需求删除后文档保留。

## 背景
<!-- 需求背景、涉及的旧逻辑位置、技术方案要点 -->
EOF
  echo
  ok "工作区已创建: ${B}$dir${N}"
  echo "   分支: $branch"
  [ ${#failed[@]} -gt 0 ] && { echo; warn "以下模块未创建:"; printf "     %s\n" "${failed[@]}"; }
  echo; echo "   文档: docs/$docdir/   (工作区内直接写 docs/*.md 即自动落位)"
  echo; echo "   ${D}下一步: cd $dir${N}"
}

cmd_add() {
  local dir; dir="$(cur_ws)"
  [ $# -gt 0 ] || die "用法: gws add <模块>..."
  local branch; branch="$(jget "$dir/.workspace.json" branch)"
  local base_from; base_from="$(jget "$dir/.workspace.json" base)"
  for m in "$@"; do
    if [ ! -d "$REPOS/$m" ]; then
      warn "$m: 仓库不存在"
      # 名字打错时给出相近候选：按逐步缩短的前缀匹配
      local near="" pfx="$m"
      while [ ${#pfx} -ge 4 ] && [ -z "$near" ]; do
        near=$(all_repos | grep -i "^$pfx" | head -5 | tr '\n' ' ')
        pfx="${pfx%?}"
      done
      [ -n "$near" ] && echo "     ${D}是否想要: $near${N}"
      continue
    fi
    [ -d "$dir/$m" ]   && { warn "$m: 已在工作区中"; continue; }
    local mainbase="origin/$(main_branch "$m")"
    local base="$mainbase" note=""
    if [ "$base_from" != "主干" ] && [ -n "$base_from" ]; then
      # 新加入的模块按工作区基线链取优先级：可能在旧阶段的分支上，
      # 也可能没参与过（阶段2 才引入的 D）→ 链解析自动兜底主干
      local out; out="$(resolve_chain_base "$m" "$base_from")"
      base="${out%%$'\n'*}"
      note="${out#*$'\n'}"; [ "$note" = "$out" ] && note=""
    fi
    if git -C "$REPOS/$m" show-ref --verify -q "refs/heads/$branch"; then
      git -C "$REPOS/$m" worktree add -q "$dir/$m" "$branch" && ok "$m ${D}(复用已有分支)${N}"
    else
      if git -C "$REPOS/$m" worktree add -q -b "$branch" "$dir/$m" "$base"; then
        git -C "$dir/$m" branch --unset-upstream 2>/dev/null   # 同上：避免上游指向主干
        if [ -n "$note" ]; then
          ok "$m ${D}← $base${N} ${Y}($note)${N}"
        else
          ok "$m ${D}← $base${N}"
        fi
      else warn "$m: 创建失败"; fi
    fi
    ws_sync_modules "$dir"
  done
}

cmd_drop() {
  local dir; dir="$(cur_ws)"
  local branch; branch="$(jget "$dir/.workspace.json" branch)"

  # 无参数：清理目录已被直接删除的模块（rm -rf 后留下的 dangling worktree 元数据）
  if [ $# -eq 0 ]; then
    local cleaned=() kept=()
    for m in $(jarr "$dir/.workspace.json" modules); do
      [ -d "$dir/$m" ] && continue
      if git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
        # 已推送到远程 → 删本地分支无提交丢失
        git -C "$REPOS/$m" worktree prune 2>/dev/null
        git -C "$REPOS/$m" branch -D "$branch" >/dev/null 2>&1
        cleaned+=("$m")
      else
        # 从未推送 → 若 feature 分支领先主干则有未保存提交，保留分支
        local ahead; ahead=$(git -C "$REPOS/$m" rev-list --count "$branch" ^"origin/$(main_branch "$m")" 2>/dev/null || echo 0)
        if [ "${ahead:-0}" != "0" ]; then
          git -C "$REPOS/$m" worktree prune 2>/dev/null
          kept+=("$m ($ahead 个提交未推送)")
        else
          git -C "$REPOS/$m" worktree prune 2>/dev/null
          git -C "$REPOS/$m" branch -D "$branch" >/dev/null 2>&1
          cleaned+=("$m")
        fi
      fi
    done
    if [ ${#cleaned[@]} -gt 0 ]; then echo; for m in "${cleaned[@]}"; do ok "$m: 目录已删除，已清理 worktree"; done; fi
    if [ ${#kept[@]} -gt 0 ]; then echo; for m in "${kept[@]}"; do warn "$m: 有未推送提交，已保留分支，可 gws add 找回"; done; echo; fi
    [ ${#cleaned[@]} -eq 0 ] && [ ${#kept[@]} -eq 0 ] && info "没有需要清理的缺失模块"
    ws_sync_modules "$dir"
    return 0
  fi

  for m in "$@"; do
    if [ ! -d "$dir/$m" ]; then
      warn "$m: 不在工作区中"
      echo "     ${D}当前工作区模块: $(jarr "$dir/.workspace.json" modules | tr '\n' ' ')${N}"
      continue
    fi
    local n; n=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    [ "$n" != "0" ] && { warn "$m: 有 $n 个未提交改动，跳过。确认要丢弃请手工处理后重试"; continue; }
    local ahead; ahead=$(git -C "$dir/$m" rev-list --count HEAD ^"origin/$(main_branch "$m")" 2>/dev/null)
    if [ "${ahead:-0}" != "0" ]; then
      warn "$m: 有 $ahead 个提交领先主干"
      read -rp "     确认丢弃这些提交? [y/N] " a; [ "$a" = y ] || continue
    fi
    git -C "$REPOS/$m" worktree remove --force "$dir/$m" 2>/dev/null
    git -C "$REPOS/$m" branch -D "$branch" >/dev/null 2>&1
    ok "$m 已移出"
  done
  ws_sync_modules "$dir"
}

# 依据实际存在的模块目录回写 modules 字段
ws_sync_modules() {
  local dir="$1" f="$1/.workspace.json"
  local ms=(); for d in "$dir"/*/; do
    d="${d%/}"; local b; b="$(basename "$d")"
    [ -e "$d/.git" ] && ms+=("$b")
  done
  local mj; mj=$(printf '"%s", ' "${ms[@]}"); mj="[${mj%, }]"
  local tmp; tmp="$(mktemp)"
  sed "s#\"modules\": \[[^]]*\]#\"modules\": $mj#" "$f" > "$tmp" && mv "$tmp" "$f"
}

cmd_ls() {
  [ -d "$WS" ] && [ -n "$(ls -A "$WS" 2>/dev/null)" ] || { echo "${D}(暂无工作区，用 gws new 创建)${N}"; return; }
  printf "%-22s %-30s %-8s %-6s %s\n" "名称" "标题" "阶段" "模块" "分支"
  for d in "$WS"/*/; do
    local f="${d}.workspace.json"; [ -f "$f" ] || continue
    local n t s b; n=$(jget "$f" name); t=$(jget "$f" title); s=$(jget "$f" stage); b=$(jget "$f" branch)
    local c; c=$(jarr "$f" modules | wc -l | tr -d ' ')
    printf "%-22s %-30s %-8s %-6s ${D}%s${N}\n" "$n" "$t" "$s" "$c" "$b"
  done
}

cmd_st() {
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json" branch; branch="$(jget "$f" branch)"
  echo "${B}$(jget "$f" title)${N}  ${D}$branch${N}"
  echo
  printf "  %-34s %-8s %-10s %s\n" "模块" "改动" "vs远程" "vs主干"
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || { printf "  %-34s ${R}目录缺失 ${D}(gws drop 清理)${N}\n" "$m"; continue; }
    local dirty ab mahead mb; mb="$(main_branch "$m")"
    dirty=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    if git -C "$dir/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      ab=$(git -C "$dir/$m" rev-list --left-right --count "HEAD...origin/$branch" | awk '{printf "↑%s ↓%s",$1,$2}')
    else ab="${Y}未推送${N}"; fi
    mahead=$(git -C "$dir/$m" rev-list --count HEAD ^"origin/$mb" 2>/dev/null)
    local dc="$G"; [ "$dirty" != "0" ] && dc="$Y"
    printf "  %-34s ${dc}%-8s${N} %-10s ${D}+%s${N}\n" "$m" "$dirty" "$ab" "${mahead:-?}"
  done
}

cmd_push() {
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json" branch; branch="$(jget "$f" branch)"

  # 落后远程时先提示 gws pull —— 比让 git 抛出 non-fast-forward 更直观
  local behind=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    git -C "$REPOS/$m" fetch --prune -q origin 2>/dev/null
    git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1 || continue
    local b; b=$(git -C "$dir/$m" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)
    [ "${b:-0}" != "0" ] && behind+=("$m: 落后 $b 个提交")
  done
  if [ ${#behind[@]} -gt 0 ]; then
    echo; echo "${R}本地落后于远程，无法推送:${N}"
    printf "  ${R}✗${N} %s\n" "${behind[@]}"
    echo; echo "  先同步他人的提交: ${B}gws pull${N}"
    return 1
  fi

  local failed=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    local n; n=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    [ "$n" != "0" ] && { warn "$m: 有 $n 个未提交改动，先提交"; failed+=("$m"); continue; }
    if git -C "$dir/$m" push -q -u origin "$branch" 2>&1 | sed 's/^/    /'; then
      ok "$m"
    else failed+=("$m"); fi
  done
  [ ${#failed[@]} -gt 0 ] && die "以下模块推送失败: ${failed[*]}"
  ok "全部已推送到 origin/$branch"
}

# 回写 .workspace.json 的 merged.<env> 日期
merge_stamp() {
  local f="$1" env="$2" tmp; tmp="$(mktemp)"
  local today; today="$(date +%Y-%m-%d)"
  if grep -q "\"$env\": " "$f" 2>/dev/null; then
    # 已有该环境的 key：null 或旧日期都覆盖为今天
    sed -E "s#\"$env\": (null|\"[0-9-]*\")#\"$env\": \"$today\"#" "$f" > "$tmp" && mv "$tmp" "$f"
  else
    # 自定义环境（gws env add 加的）首次合并：插进 merged 对象
    sed "s#\"merged\": {#\"merged\": { \"$env\": \"$today\",#" "$f" > "$tmp" && mv "$tmp" "$f"
  fi
}

# ── merge：核心命令 ───────────────────────────────────────────────────
# 设计：默认只合并到本地 envs（不推、不问），review 决定后再 push。
#   gws merge dev            → 合到本地 envs/dev，完成后提示推送方式
#   gws merge dev --push     → 合并后直接推送（无新内容时只推已有成果）
#   gws merge dev --force    → 丢弃 envs 本地未推送的合并成果，从远程重新合
#   gws merge dev --yes      → 非交互场景（脚本/CI）同 --push
cmd_merge() {
  local env="${1:-}"; shift || true
  case "$env" in
    "" |-*) die "用法: gws merge <环境分支> [--push] [--force] [--yes]
     ${D}当前环境: $(all_envs | paste -sd '|' -)   (gws env add 可增加)${N}";;
    *) all_envs | grep -qx "$env" \
         || warn "$env 不在环境列表中（临时特例，注意收尾；可 ${B}gws env add $env${N} 纳管）";;
  esac
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json" branch; branch="$(jget "$f" branch)"
  local dopush=0 force=0 yes=0
  for a in "$@"; do case "$a" in
    --push) dopush=1;; --force) force=1;; --yes|-y) yes=1;;
    *) die "未知参数: $a  ${D}(--push|--force|--yes)${N}";;
  esac; done

  # ── 前置闸门：本地 feature 分支落后远程时先停下 ────────────────────
  # 协作场景：同事已推送新提交，此时直接合入环境分支会用旧代码覆盖其成果。
  local behind=() unpushed_ws=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    git -C "$REPOS/$m" fetch --prune -q origin 2>/dev/null
    git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1 || continue
    local b a
    b=$(git -C "$dir/$m" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)
    a=$(git -C "$dir/$m" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)
    [ "${b:-0}" != "0" ] && behind+=("$m: 落后 $b 个提交$([ "${a:-0}" != "0" ] && echo "，本地另有 $a 个未推送")")
    [ "${b:-0}" = "0" ] && [ "${a:-0}" != "0" ] && unpushed_ws+=("$m: $a 个提交未推送")
  done
  if [ ${#behind[@]} -gt 0 ] && [ "$force" = 0 ]; then
    echo; echo "${R}本地 feature 分支落后于远程:${N}"
    printf "  ${R}✗${N} %s\n" "${behind[@]}"
    echo
    echo "  ${D}他人已推送新提交。直接合入 $env 会用旧代码覆盖其成果。${N}"
    echo "  先同步再合并: ${B}gws pull${N} → ${B}gws push${N} → ${B}gws merge $env${N}"
    return 1
  fi
  if [ ${#unpushed_ws[@]} -gt 0 ]; then
    echo; warn "以下模块有未推送的提交，不会被合入（merge 只从 origin/$branch 拉）:"
    printf "     %s\n" "${unpushed_ws[@]}"
    echo "     ${D}需要一并合入请先 ${B}gws push${N}"
  fi

  # ── 单遍处理每个模块：保护未推成果与冲突现场，绝不 reset 掉它们 ──
  local stale=() conflict=() clean=() pending=() skipped=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    local wt="$ENVS/$env/$m"
    has_remote "$m" "$env" || { skipped+=("$m: 远程无 $env 分支"); continue; }
    [ -d "$wt" ] || git -C "$REPOS/$m" worktree add -q -b "$env" "$wt" "origin/$env" 2>/dev/null
    git -C "$REPOS/$m" fetch --prune -q origin 2>/dev/null

    # ① 远程被重建(force push)：本地 HEAD 不再包含远程 tip → 本地副本全部作废。
    #    必须先于冲突检测判断——此时本地的冲突现场也是基于旧基线的，一并丢弃。
    #    重置后不 continue：继续走到 ④ 完成合并，否则要跑两次 merge 才合得进去。
    if ! git -C "$wt" merge-base --is-ancestor "origin/$env" HEAD 2>/dev/null; then
      git -C "$wt" merge --abort 2>/dev/null
      git -C "$wt" reset --hard -q "origin/$env"
      git -C "$wt" clean -fdq -e node_modules -e target 2>/dev/null
      stale+=("$m")
    fi

    # ② 合并中途（正在解冲突）：已解完 → 补提交；还没解完 → 记为待解决，留现场
    if git -C "$wt" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
      if [ -n "$(git -C "$wt" diff --name-only --diff-filter=U)" ]; then
        conflict+=("$m"); continue
      fi
      git -C "$wt" -c core.editor=true commit -q --no-edit 2>/dev/null
    fi

    # ③ 已有未推送成果（含在 IDE 中完成的冲突解决提交）：不 reset、不重合，保住成果
    local ahead; ahead=$(git -C "$wt" rev-list --count "origin/$env..HEAD" 2>/dev/null || echo 0)
    if [ "${ahead:-0}" != "0" ]; then
      if [ "$force" = 0 ]; then pending+=("$m"); continue; fi
      git -C "$wt" merge --abort 2>/dev/null
      git -C "$wt" reset --hard -q "origin/$env"   # --force：丢弃本地成果从远程重新合
      git -C "$wt" clean -fdq -e node_modules -e target 2>/dev/null
    fi

    # ④ 镜像重置 + 从 origin/<feature> 合（忘记 push 就合不进去）
    git -C "$wt" reset --hard -q "origin/$env"
    git -C "$wt" clean -fdq -e node_modules -e target 2>/dev/null
    if ! git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      skipped+=("$m: origin/$branch 不存在，先 gws push"); continue
    fi
    if git -C "$wt" merge -q --no-edit "origin/$branch" 2>/dev/null; then
      clean+=("$m")
    else
      conflict+=("$m")
    fi
  done

  # 输出概要
  if [ ${#stale[@]} -gt 0 ]; then
    echo; warn "以下模块的 origin/$env 已被重建，本地副本作废，已重置到最新并重新合并:"
    for m in "${stale[@]}"; do echo "     ${G}✓${N} $m"; done
  fi
  if [ ${#pending[@]} -gt 0 ]; then
    echo; echo "${B}待推送成果 (${#pending[@]}):${N}"
    for m in "${pending[@]}"; do
      local pn; pn=$(git -C "$ENVS/$env/$m" rev-list --count "origin/$env..HEAD" 2>/dev/null)
      echo "  ${D}~${N} $m ${D}($pn 个提交待推)${N}"
    done
  fi
  if [ ${#clean[@]} -gt 0 ]; then
    echo; echo "${G}干净合并 (${#clean[@]}):${N}"; printf "  ✓ %s\n" "${clean[@]}"
  fi
  if [ ${#skipped[@]} -gt 0 ]; then
    echo; echo "${Y}跳过 (${#skipped[@]}):${N}"; printf "  - %s\n" "${skipped[@]}"
  fi
  if [ ${#conflict[@]} -gt 0 ]; then
    echo; echo "${R}冲突待处理 (${#conflict[@]}):${N}"
    for m in "${conflict[@]}"; do
      echo "  ${R}✗${N} $m"
      git -C "$ENVS/$env/$m" diff --name-only --diff-filter=U 2>/dev/null | sed 's/^/      /'
      echo "      ${D}$ENVS/$env/$m${N}"
    done
    echo
    echo "  用 IDE 打开上述目录解决冲突（解决后 Commit 或不 Commit 都行），然后:"
    echo "    ${B}gws merge $env --push${N}   ${D}# 再跑一次：补提交 + 推送，一步收尾${N}"
    echo "    ${D}gws merge $env${N}          ${D}# 或先合到本地 review，稍后 --push 推${N}"
    return 1
  fi

  # ── 推送决策：默认只合到本地，绝不自动推 ──
  # 注：macOS 自带 bash 3.2 在 set -u 下展开空数组会误报 unbound，故一律用 ${a[@]+...} 保护
  local all=(${pending[@]+"${pending[@]}"} ${clean[@]+"${clean[@]}"})
  if [ ${#all[@]} -eq 0 ]; then
    [ ${#skipped[@]} -gt 0 ] && { echo; warn "没有任何模块可合并（见上方跳过项）"; }
    return 1
  fi

  if [ "$dopush" = 1 ] || [ "$yes" = 1 ]; then
    echo; info "推送到 origin/$env"
    local pf=()
    for m in "${all[@]}"; do
      git -C "$ENVS/$env/$m" push -q origin "$env" && ok "$m" || { warn "$m 推送失败"; pf+=("$m"); }
    done
    [ ${#pf[@]} -gt 0 ] && return 1
    merge_stamp "$f" "$env"
    echo; ok "已合入并推送 origin/$env"
  else
    echo
    echo "  ${D}已合并到本地 envs/${env}，review 确认后再推送: ${B}gws merge $env --push${N}"
    echo "  ${D}想丢弃本地合并成果重新合并: ${B}gws merge $env --force${N}"
  fi
}

# 基线链解析：--from ws:阶段2,ws:阶段1 → 按优先级取该模块第一个存在的远端 ref。
# - 多个来源逗号分隔，顺序即优先级（第一个最优先）
# - 上游工作区不存在 / 该模块无此分支 → 自动尝试下一来源
# - 全部都不存在 → 兜底主干（自动，无需在链里写）
# 约定与 merge 一致：一律从远程分支合。裸 ref 自动补 origin/ 前缀。
# stdout 两行：第一行 ref，第二行解析说明（'' 表示首源即命中）。
# 注意：不能靠全局变量回传 —— 命令替换 $(...) 在子 shell 里执行，赋值传不回来。
resolve_chain_base() {
  local m="$1" chain="$2" src miss=() ref1 ref=""
  local IFS=','; local -a SRC; read -ra SRC <<< "$chain"; unset IFS
  for src in ${SRC[@]+"${SRC[@]}"}; do
    src="$(echo "$src" | xargs)"; [ -n "$src" ] || continue
    case "$src" in
      主干|main|master)   ref1="origin/$(main_branch "$m")";;
      ws:*)
        local pw="$WS/${src#ws:}"
        [ -f "$pw/.workspace.json" ] || { miss+=("$src"); continue; }
        ref1="origin/$(jget "$pw/.workspace.json" branch)";;
      origin/*)            ref1="$src";;
      *)                    ref1="origin/$src";;
    esac
    if git -C "$REPOS/$m" rev-parse --verify -q "$ref1" >/dev/null 2>&1; then
      ref="$ref1"; break
    fi
    miss+=("$src")
  done
  if [ -n "$ref" ]; then
    echo "$ref"
    [ ${#miss[@]} -gt 0 ] && echo "按优先级回退（${miss[*]} 无此分支）"
    return 0
  fi
  echo "origin/$(main_branch "$m")"
  echo "上游全部无此分支，降级主干"
}

cmd_sync_main() {
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json"
  local from="" yes=0
  while [ $# -gt 0 ]; do case "$1" in
    --from) from="$2"; shift 2;;
    --yes|-y) yes=1; shift;;
    -*) die "未知参数: $1  ${D}(--from <ref>|--yes)${N}";;
    *) from="$1"; shift;;
  esac; done

  # 未显式指定来源时，默认取创建工作区时的基线 base：
  #   主干      → origin/<main>；ws:xxx → 上游工作区分支（阶段依赖）；<ref> → 该 ref
  [ -n "$from" ] || from="$(jget "$f" base)"
  [ -n "$from" ] || from="主干"

  echo "${B}同步来源: ${from}${N}"

  # 有未提交改动不再跳过——和自己手动从主干合下来一样，直接合进当前工作树。
  # 但先一次性列清楚、问一句，免得冲突现场来得猝不及防。
  local dirty=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    local n; n=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    [ "$n" != "0" ] && dirty+=("$m: $n 个未提交改动")
  done
  if [ ${#dirty[@]} -gt 0 ] && [ "$yes" = 0 ]; then
    warn "以下模块有未提交改动:"; printf "     %s\n" "${dirty[@]}"
    echo "     ${D}会自动 stash → 合并 → 回填（git merge --autostash）；${N}"
    echo "     ${D}若与来源改到同一处，冲突会留在工作树里等你手动解决${N}"
    if [ -t 0 ]; then
      read -rp "     是否继续? [y/N] " a
      case "$a" in y|Y) ;; *) echo "  已取消"; return 1;; esac
    else
      echo "     ${D}先提交改动，或加 --yes / 用交互模式确认${N}"; return 1
    fi
  fi

  local conflict=() restash=() blocked=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    local src note=""
    local out; out="$(resolve_chain_base "$m" "$from")"
    src="${out%%$'\n'*}"
    note="${out#*$'\n'}"; [ "$note" = "$out" ] && note=""
    git -C "$REPOS/$m" fetch -q origin 2>/dev/null
    if ! git -C "$REPOS/$m" rev-parse --verify -q "$src" >/dev/null 2>&1; then
      # 来源分支在该模块不存在 → 降级主干。
      # 阶段2 依赖阶段1 时，阶段2 新引入的模块不会有阶段1 的分支，从主干同步才对。
      local mb; mb="$(main_branch "$m")"
      if [ "$src" = "origin/$mb" ]; then
        warn "$m: 主干 $src 不存在，跳过"; continue
      fi
      warn "$m: 来源 $src 不存在，降级 origin/$mb"
      src="origin/$mb"
    fi
    # 有未提交改动时加 --autostash：git 先替你 stash，合完再回填。
    # 不加的话 git 会因"本地改动会被覆盖"整个拒绝合并，等于把人挡在门外。
    local ast=()
    [ "$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')" != "0" ] && ast=(--autostash)
    local mout mrc
    mout="$(git -C "$dir/$m" merge --no-edit ${ast[@]+"${ast[@]}"} "$src" 2>&1)"; mrc=$?

    # 注意：回填 stash 产生的冲突，git 仍然返回 0 —— 只能靠 unmerged 路径判断，不能只看退出码
    local unmerged; unmerged="$(git -C "$dir/$m" diff --name-only --diff-filter=U)"
    if [ -n "$unmerged" ]; then
      echo "$unmerged" | sed 's/^/      /'
      if git -C "$dir/$m" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        # 合并本身冲突。此时未提交改动被 git 暂存在 MERGE_AUTOSTASH，
        # 工作树里暂时看不到——解决冲突 commit 后 git 会自动回填，别慌。
        conflict+=("$m"); echo "  ${R}✗${N} $m ${D}(合并冲突)${N}"
      else
        # 合并成功了，是回填未提交改动时撞车。解决后 git add 即可，无需 commit。
        # git 出于安全会把 stash 条目留着，得手动 drop。
        restash+=("$m"); echo "  ${R}✗${N} $m ${D}(改动回填冲突)${N}"
      fi
    elif [ $mrc = 0 ]; then
      if [ -n "$note" ]; then ok "$m ${D}(← $src ${note})${N}"
      else ok "$m ${D}(← $src 最新)${N}"; fi
    else
      # 其余失败：多见于本地未跟踪文件与来源新增文件同名（--autostash 不管未跟踪文件）
      blocked+=("$m"); echo "  ${R}✗${N} $m ${D}(未开始合并)${N}"
      echo "$mout" | sed 's/^/      /'
    fi
  done

  local rv=0
  if [ ${#conflict[@]} -gt 0 ]; then
    echo; warn "合并冲突: ${conflict[*]}"
    echo "  ${D}IDEA 打开 ws/<需求>/<模块> 解决后 git commit${N}"
    echo "  ${D}你原先未提交的改动被 git 暂存起来了，commit 完会自动回到工作树${N}"
    rv=1
  fi
  if [ ${#restash[@]} -gt 0 ]; then
    echo; warn "改动回填冲突: ${restash[*]}"
    echo "  ${D}来源已经合进来了，是你未提交的改动和它撞在同一处${N}"
    echo "  ${D}IDEA 里解决后 git add 即可（不用 commit），再 git stash drop 清掉残留条目${N}"
    rv=1
  fi
  if [ ${#blocked[@]} -gt 0 ]; then
    echo; warn "未开始合并: ${blocked[*]}"
    echo "  ${D}多为未跟踪文件与来源新增文件同名，按上面 git 的提示处理后重跑${N}"
    rv=1
  fi
  [ $rv = 0 ] && ok "全部已同步 $from"
  return $rv
}

# 删除单个工作区；返回 0/1（供 cmd_rm 批量循环）
rm_one() {
  local name="$1" force="$2"
  local dir="$WS/$name"; local f="$dir/.workspace.json"
  [ -f "$f" ] || { warn "工作区不存在: $name"; return 1; }
  local branch; branch="$(jget "$f" branch)"
  # 元数据一次读全：后面 rm -rf 掉目录后就读不到了
  local docdir; docdir="$(jget "$f" docs)"
  local -a mods; mods=( $(jarr "$f" modules) )
  # bash 3.2: 空数组直接展开 "${mods[@]}" 会报 unbound variable，
  # 统一用 ${mods[@]+"${mods[@]}"} 保护（下方同名）。模块全被 drop 掉后列表为空，同样安全。

  local risky=()
  for m in ${mods[@]+"${mods[@]}"}; do
    [ -d "$dir/$m" ] || continue
    local n; n=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    [ "$n" != "0" ] && risky+=("$m: $n 个未提交改动")
    if git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      local un; un=$(git -C "$dir/$m" rev-list --count HEAD ^"origin/$branch" 2>/dev/null)
      [ "${un:-0}" != "0" ] && risky+=("$m: $un 个提交未推送")
    else
      risky+=("$m: 分支从未推送到远程")
    fi
  done
  if [ ${#risky[@]} -gt 0 ] && [ "$force" = 0 ]; then
    warn "存在未保存的工作:"; printf "     %s\n" "${risky[@]}"
    echo; echo "  确认丢弃请加 --force，或先 gws push"; return 1
  fi

  for m in ${mods[@]+"${mods[@]}"}; do
    [ -d "$dir/$m" ] || continue
    git -C "$REPOS/$m" worktree remove --force "$dir/$m" 2>/dev/null
    git -C "$REPOS/$m" branch -D "$branch" >/dev/null 2>&1
  done
  rm -f "$dir/docs"; rm -rf "$dir"
  # 文档只归档不删
  if [ -d "$DOCS/$docdir" ]; then
    mkdir -p "$DOCS/_archive"
    mv "$DOCS/$docdir" "$DOCS/_archive/$docdir" 2>/dev/null \
      && ok "文档已归档: docs/_archive/$docdir/"
  fi
  # 远程该 feature 分支若曾被推送，提醒清理（本地删不掉远程）
  for m in ${mods[@]+"${mods[@]}"}; do
    if git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      warn "$m: 远程分支 origin/$branch 仍存在，确认无人使用后可删除:"
      echo "    git -C repos/$m push origin --delete $branch"
      break
    fi
  done
  ok "工作区 $name 已删除"
}

cmd_rm() {
  local names=() force=0 rv=0
  for a in "$@"; do case "$a" in
    --force) force=1;;
    *) names+=("$a");;
  esac; done
  [ ${#names[@]} -gt 0 ] || die "用法: gws rm <名称> [<名称>...] [--force]"
  for name in "${names[@]}"; do
    rm_one "$name" "$force" || rv=1
  done
  return $rv
}

# ── rename：工作区改名（名称 / feature 分支 / docs 目录统一处理）────────
# 顺序：先读全元数据（mv 之后旧路径失效，不能再读 $f_old）→ 移动目录 → 修元数据
cmd_rename() {
  local old="${1:-}" new="${2:-}" branch="" title=""
  shift 2 2>/dev/null || true
  while [ $# -gt 0 ]; do case "$1" in
    --branch|-b) branch="$2"; shift 2;;
    --title|-t)  title="$2"; shift 2;;
    *) die "未知参数: $1  ${D}(--branch <新分支名> | --title \"新标题\")${N}";;
  esac; done
  [ -n "$old" ] && [ -n "$new" ] || die "用法: gws rename <旧名> <新名> [--branch <新分支名>] [--title \"新标题\"]"
  [ "$old" != "$new" ] || die "新旧名称相同"
  validate_ws_name "$new" "新名称"

  local d_old="$WS/$old" d_new="$WS/$new"
  local f_old="$d_old/.workspace.json"
  [ -f "$f_old" ] || die "工作区不存在: $old"
  [ -e "$d_new" ] && die "目标名称已存在: $new"

  # ① 在移动前读取全部元数据（之后旧路径不可用）
  local o_branch; o_branch="$(jget "$f_old" branch)"
  local docdir_old; docdir_old="$(jget "$f_old" docs)"
  local -a mods; mods=( $(jarr "$f_old" modules) )

  # ② 新分支名：保留原有的「前缀-日期-」结构，仅替换末尾的需求名。
  #    形如 feature-20260101-old / hotfix-20260101-old 均可；
  #    完全自定义的分支名（无法识别结构）则要求显式 --branch。
  if [ -z "$branch" ]; then
    local head_part; head_part=$(echo "$o_branch" | sed -n 's/^\([a-zA-Z]\{1,\}-[0-9]\{8\}-\).*/\1/p')
    if [ -n "$head_part" ]; then
      branch="$head_part$new"
    else
      die "无法从 $o_branch 推导新分支名，请显式指定: ${B}gws rename $old $new --branch <新分支名>${N}"
    fi
  fi
  [ "$branch" = "$o_branch" ] && { warn "分支名未变化（${branch}），仍继续处理名称/目录"; }

  # ③ 简单校验：目标分支不能已在某处被占用（同一仓库内改名）
  for m in "${mods[@]}"; do
    [ -d "$d_old/$m" ] || continue
    if git -C "$REPOS/$m" show-ref --verify -q "refs/heads/$branch" && [ "$branch" != "$o_branch" ]; then
      die "$m: 新分支 $branch 在该仓库已存在，换 --branch"
    fi
  done

  # ④ 移动目录 + 修复每个模块的 worktree 元数据
  mv "$d_old" "$d_new"
  for m in "${mods[@]}"; do
    [ -d "$d_new/$m" ] || continue
    git -C "$REPOS/$m" worktree repair "$d_new/$m" 2>/dev/null \
      || warn "$m: worktree repair 失败"
  done

  # ⑤ 分支改名（在模块 worktree 内，当前即该分支）
  if [ "$branch" != "$o_branch" ]; then
    for m in "${mods[@]}"; do
      [ -d "$d_new/$m" ] || continue
      git -C "$d_new/$m" branch -m "$o_branch" "$branch" 2>/dev/null \
        || warn "$m: 分支改名失败（$o_branch → ${branch}）"
    done
  fi

  # ⑥ 更新 .workspace.json：name / branch / docs / title
  local docdir_new; docdir_new="$(echo "$docdir_old" | sed "s/-$old$/-$new/")"
  local tmp; tmp="$(mktemp)"
  sed -E \
    -e "s#\"name\": \"$old\"#\"name\": \"$new\"#" \
    -e "s#\"branch\": \"$o_branch\"#\"branch\": \"$branch\"#" \
    -e "s#\"docs\": \"$docdir_old\"#\"docs\": \"$docdir_new\"#" \
    "$d_new/.workspace.json" > "$tmp" && mv "$tmp" "$d_new/.workspace.json"
  if [ -n "$title" ]; then
    local tmp2; tmp2="$(mktemp)"
    sed "s#\"title\": \"[^\"]*\"#\"title\": \"$title\"#" "$d_new/.workspace.json" > "$tmp2" \
      && mv "$tmp2" "$d_new/.workspace.json"
  fi

  # ⑦ docs 目录改名 + 软链
  if [ -d "$DOCS/$docdir_old" ]; then
    mv "$DOCS/$docdir_old" "$DOCS/$docdir_new" 2>/dev/null
  fi
  ln -sfn "../../docs/$docdir_new" "$d_new/docs"

  # ⑧ 工作区 CLAUDE.md 里的名字/分支
  if [ -f "$d_new/CLAUDE.md" ]; then
    local tmp3; tmp3="$(mktemp)"
    sed -E \
      -e "s#\`$old\`#\`$new\`#g" \
      -e "s#\`$o_branch\`#\`$branch\`#g" \
      "$d_new/CLAUDE.md" > "$tmp3" && mv "$tmp3" "$d_new/CLAUDE.md"
  fi

  # ⑨ 其他工作区对旧名的依赖（base: ws:<旧名>）自动改指向新名
  for w in "$WS"/*/; do
    [ -f "$w/.workspace.json" ] || continue
    if grep -q "\"base\": \"ws:$old\"" "$w/.workspace.json" 2>/dev/null; then
      local tmp4; tmp4="$(mktemp)"
      sed "s#\"base\": \"ws:$old\"#\"base\": \"ws:$new\"#" "$w/.workspace.json" > "$tmp4" \
        && mv "$tmp4" "$w/.workspace.json"
      info "已更新依赖: $w → ws:$new"
    fi
  done

  echo
  ok "已改名: $old → $new"
  echo "   分支: $o_branch → $branch"
  echo "   文档: docs/$docdir_new/"
  echo
  echo "  ${D}提示: 若旧分支 $o_branch 曾被推送，在代码托管平台手动删除该远程分支即可${N}"
  echo "  ${D}另: 引用旧名的手工文档/交接内容请自行更新${N}"
}

cmd_done() {
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json" name branch; name=$(jget "$f" name); branch="$(jget "$f" branch)"
  local unmerged=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    local mb; mb="$(main_branch "$m")"
    git -C "$REPOS/$m" fetch -q origin "$mb"
    local n; n=$(git -C "$dir/$m" rev-list --count HEAD ^"origin/$mb" 2>/dev/null)
    [ "${n:-0}" != "0" ] && unmerged+=("$m: $n 个提交尚未进入 $mb")
  done
  if [ ${#unmerged[@]} -gt 0 ]; then
    warn "以下模块尚未并入主干:"; printf "     %s\n" "${unmerged[@]}"
    echo; echo "  ${D}主干合并需在代码托管平台发起 Merge/Pull Request 并完成评审${N}"
    return 1
  fi
  ok "所有模块已并入主干"
  echo "  ${D}删除工作区(文档自动归档): ${B}gws rm $name${N}"
}

# 文档统一纳入 docs git 仓库：AI 生成的文档落到工作区 docs/ 后，一条命令自动纳管
doc_commit() {
  local msg="${1:-文档更新}"
  git -C "$DOCS" add -A 2>/dev/null || return 0
  git -C "$DOCS" diff --cached --quiet 2>/dev/null && return 0
  { git -C "$DOCS" commit -q -m "$msg" && ok "文档已纳入 git: $msg"; } || warn "docs commit 失败"
}

cmd_doc() {
  local sub="${1:-st}"; shift || true
  local dir; dir="$(cur_ws)"
  local docdir; docdir="$DOCS/$(jget "$dir/.workspace.json" docs)"
  case "$sub" in
    new)
      local fn="${1:-}"; [ -n "$fn" ] || die "用法: gws doc new <文件名>"
      [[ "$fn" == *.md ]] || fn="$fn.md"
      local p="$docdir/$fn"; [ -e "$p" ] && die "已存在: $p"
      cat > "$p" <<EOF
---
title: ${fn%.md}
workspace: $(jget "$dir/.workspace.json" name)
created: $(date +%Y-%m-%d)
confluence:
  page_id: null
  url: null
  synced_at: null
  synced_sha256: null
---

# ${fn%.md}

EOF
      doc_commit "新建文档 $(basename "$p")";;
    ls|st)
      echo "${B}$(basename "$docdir")${N}"
      shopt -s nullglob
      for md in "$docdir"/*.md; do
        local pid; pid=$(sed -n 's/^[[:space:]]*page_id:[[:space:]]*"\?\([0-9]*\)"\?.*/\1/p' "$md" | head -1)
        if [ -n "$pid" ]; then
          echo "  ${G}●${N} $(basename "$md")  ${D}wiki:$pid${N}"
        else
          echo "  ${D}○${N} $(basename "$md")  ${D}(未上传)${N}"
        fi
      done
      shopt -u nullglob;;
    push)
      # 上传器为可选外部集成：默认路径可用 GWS_DOC_UPLOADER 覆盖。
      # 未配置时 gws doc commit 仍可正常做本地文档版本管理。
      local up="${GWS_DOC_UPLOADER:-$HOME/.claude/skills/x-confluence-uploader/upload.py}"
      [ -f "$up" ] || die "未找到文档上传器: $up
     ${D}这是可选集成。配置自己的上传脚本: ${B}export GWS_DOC_UPLOADER=/path/to/upload.py${N}
     ${D}或仅做本地纳管: ${B}gws doc commit${N}"
      local files=("$@"); [ ${#files[@]} -eq 0 ] && { shopt -s nullglob; files=("$docdir"/*.md); shopt -u nullglob; }
      [ ${#files[@]} -gt 0 ] || die "docs/ 下没有任何 .md 文件可上传"
      for md in ${files[@]+"${files[@]}"}; do
        [ -f "$md" ] || md="$docdir/$md"; [ -f "$md" ] || { warn "找不到: $md"; continue; }
        doc_commit "上传前纳管: $(basename "$md")"
        info "上传 $(basename "$md")"
        if python3 "$up" "$md"; then doc_commit "同步 Confluence: $(basename "$md")"; else warn "失败: $(basename "$md")"; fi
      done;;
    commit)
      doc_commit "${*:-文档更新}";;
    *) die "用法: gws doc new|ls|push|commit";;
  esac
}

cmd_sync() {
  info "同步所有仓库主干"
  prune_all_repos
  local fail=()
  for p in $(all_repos); do
    local mb; mb="$(main_branch "$p")"
    git -C "$REPOS/$p" fetch --prune -q origin 2>/dev/null || { fail+=("$p: fetch 失败"); continue; }
    local n; n=$(git -C "$REPOS/$p" status --porcelain | wc -l | tr -d ' ')
    [ "$n" != "0" ] && { warn "$p: 有未提交改动，跳过"; continue; }
    git -C "$REPOS/$p" reset --hard -q "origin/$mb" && echo "  ${G}✓${N} $p ${D}($mb)${N}" || fail+=("$p")
  done
  [ ${#fail[@]} -gt 0 ] && { echo; warn "失败: ${fail[*]}"; }
  echo
  if [ -z "$(all_envs)" ]; then
    warn "envs/ 下没有任何环境目录"
    echo "     ${D}创建: ${B}gws env add dev pre${N}"
    [ ${#fail[@]} -gt 0 ] && return 1
    return 0
  fi
  info "同步 envs (reset 到远程，新增仓库自动补建)"
  local env_fail=()
  for env in $(all_envs); do
    local added=0 same=0
    local moved=()
    local fail0=${#env_fail[@]}   # 记下入口失败数，用于判断本环境是否出过错
    for p in $(all_repos); do
      local wt="$ENVS/$env/$p"
      has_remote "$p" "$env" || continue
      if [ ! -d "$wt" ]; then
        if git -C "$REPOS/$p" rev-parse --verify -q "refs/heads/$env" >/dev/null 2>&1; then
          git -C "$REPOS/$p" worktree add -q "$wt" "$env" 2>/dev/null \
            || { echo "  ${R}✗${N} $env/$p ${D}(worktree 创建失败)${N}"; env_fail+=("$env/$p"); continue; }
        else
          git -C "$REPOS/$p" worktree add -q -b "$env" "$wt" "origin/$env" 2>/dev/null \
            || { echo "  ${R}✗${N} $env/$p ${D}(worktree 创建失败)${N}"; env_fail+=("$env/$p"); continue; }
        fi
        added=$((added+1))
      fi

      # 先记下 reset 前后的位置——只有这样才能说清「代码到底更没更新、前进了几个提交」，
      # 也才能识别出 reset 静默失败（旧版本这里 2>/dev/null 且无 || ，失败照样报 ✓）
      local tgt before after
      tgt="$(git -C "$REPOS/$p" rev-parse "origin/$env" 2>/dev/null || true)"
      [ -n "$tgt" ] || { echo "  ${R}✗${N} $env/$p ${D}(读不到 origin/$env)${N}"; env_fail+=("$env/$p"); continue; }
      before="$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)"
      [ "$before" = "$tgt" ] && { same=$((same+1)); continue; }

      local rout; rout="$(git -C "$wt" reset --hard -q "origin/$env" 2>&1)"
      after="$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)"
      if [ "$after" = "$tgt" ]; then
        # 双向统计。只数 before..tgt 的话，远程被删库重建/强推回退时会算出 0，
        # 等于把「提交被抹掉了」这件事藏起来——回退和分叉都必须显式报出来。
        local fwd bwd
        fwd="$(git -C "$REPOS/$p" rev-list --count "$before..$tgt" 2>/dev/null || echo 0)"
        bwd="$(git -C "$REPOS/$p" rev-list --count "$tgt..$before" 2>/dev/null || echo 0)"
        if   [ "${fwd:-0}" != 0 ] && [ "${bwd:-0}" != 0 ]; then
          moved+=("$p ${G}+$fwd${N} ${Y}-$bwd${N} ${D}(远程已重建/强推，本地按远程为准)${N}")
        elif [ "${bwd:-0}" != 0 ]; then
          moved+=("$p ${Y}-$bwd${N} ${D}(远程回退)${N}")
        elif [ "${fwd:-0}" != 0 ]; then
          moved+=("$p ${G}+$fwd${N}")
        else
          moved+=("$p")
        fi
        continue
      fi

      # reset 没成功。envs 是远程镜像，绝大多数情况直接重建即可自愈。
      # 但 §6.2 允许在 envs 里解决合并冲突，重建会毁掉尚未推送的成果——
      # 因此只在「无本地改动 且 无未推送提交」时才动手，否则保留现场交给人判断。
      local dirty ahead safe=0
      dirty="$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
      ahead="$(git -C "$REPOS/$p" rev-list --count "origin/$env..$before" 2>/dev/null || echo 0)"
      case "$wt" in "$ENVS"/*/*)
        [ "${dirty:-1}" = "0" ] && [ "${ahead:-1}" = "0" ] && safe=1;;
      esac

      if [ "$safe" = 1 ]; then
        rm -rf "$wt" 2>/dev/null
        git -C "$REPOS/$p" worktree prune 2>/dev/null
        # 目录已移除并 prune，本地分支不再被占用，可安全指回远程
        git -C "$REPOS/$p" branch -f "$env" "origin/$env" >/dev/null 2>&1
        if git -C "$REPOS/$p" worktree add -q "$wt" "$env" 2>/dev/null \
           && [ "$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)" = "$tgt" ]; then
          moved+=("$p ${D}(reset 失败，已自动重建)${N}")
          continue
        fi
        echo "  ${R}✗${N} $env/$p ${D}(reset 失败，自动重建也失败)${N}"
      else
        echo "  ${R}✗${N} $env/$p ${D}(reset 失败；有未推送成果，未自动重建)${N}"
        echo "     ${D}本地改动 $dirty 处，未推送提交 $ahead 个${N}"
      fi
      [ -n "$rout" ] && echo "$rout" | sed 's/^/     /'
      env_fail+=("$env/$p")
    done

    # 本环境有模块失败时不再打「全部已是最新」——上面的 ✗ 行才是结论
    if [ ${#moved[@]} -gt 0 ]; then
      ok "envs/$env ${D}更新 ${#moved[@]} 个 / 新增 $added / 已最新 $same${N}"
      printf "     %s\n" ${moved[@]+"${moved[@]}"}
    elif [ ${#env_fail[@]} = "$fail0" ]; then
      ok "envs/$env ${D}全部已是最新 (新增 $added / 已最新 $same)${N}"
    fi
  done

  if [ ${#env_fail[@]} -gt 0 ] || [ ${#fail[@]} -gt 0 ]; then
    echo
    [ ${#env_fail[@]} -gt 0 ] && {
      warn "envs 同步失败: ${env_fail[*]}"
      echo "  ${D}envs 只是远程镜像。确认里面没有要保留的东西后，直接删掉重跑即可:${N}"
      echo "  ${D}  rm -rf envs/<环境>/<模块> && gws sync${N}"
      echo "  ${D}若里面有未推送的冲突解决成果，先 gws merge <环境> --push 推走${N}"
    }
    return 1
  fi
  return 0
}

# ══ hub 管理：init / migrate（可在任意目录执行）════════════════════════
cmd_init() {
  local target="${1:-}"; shift || true
  local envs="dev"   # 默认只建 dev，其余（pre/dev1/dev_tmp…）按需 gws env add
  while [ $# -gt 0 ]; do case "$1" in
    --envs) envs="$2"; shift 2;;
    *) die "未知参数: $1  ${D}(--envs dev,pre)${N}";;
  esac; done

  # 未指定目录 → 交互询问
  if [ -z "$target" ]; then
    if [ -t 0 ]; then
      echo "${B}创建新的 gws hub${N}"
      echo "  ${D}hub 是统一管理所有仓库与需求工作区的根目录（如 ~/Documents/dev/myhub）${N}"
      echo
      read -rp "  在哪里创建? " target
      [ -n "$target" ] || die "未指定目录"
    else
      die "用法: gws init <目录> [--envs dev,pre]"
    fi
  fi

  # 展开 ~，并转成绝对路径（目标可能尚不存在，故按父目录解析）
  target="${target/#\~/$HOME}"
  case "$target" in
    /*) ;;
    *)  local p_dir; p_dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)" \
          || die "父目录不存在: $(dirname "$target")"
        target="$p_dir/$(basename "$target")";;
  esac
  [ -e "$target/.gws-hub" ] && die "该目录已是 hub: $target
     ${D}直接使用: ${B}cd $target${N}   ${D}查看内容: ${B}gws repo ls --hub $target${N}"

  # 嵌套检查：hub 套 hub 会让向上查找 .gws-hub 的定位逻辑产生歧义
  local outer; outer="$(find_hub "$(dirname "$target")" 2>/dev/null)"
  if [ -n "$outer" ]; then
    die "目标位于已有 hub 内部，不能嵌套: ${B}$outer${N}
     ${D}请换到该 hub 之外的路径创建${N}"
  fi

  if [ -d "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
    warn "目录非空: $target"
    if [ -t 0 ]; then
      read -rp "  仍在此目录初始化 hub? [y/N] " a
      case "$a" in y|Y) ;; *) die "已取消";; esac
    else
      die "目录非空，请换空目录（或交互模式确认）"
    fi
  fi

  mkdir -p "$target"/{repos,envs,ws,docs/_archive} || die "创建目录失败: $target"
  set_hub "$target"

  # 环境即 envs/ 下的目录；仓库添加后跑 gws sync 补建各环境 worktree
  local IFS=','; for e in $envs; do
    e="$(echo "$e" | xargs)"; [ -n "$e" ] && mkdir -p "$ENVS/$e"
  done; unset IFS

  cat > "$HUB/.gws-hub" <<EOF
# gws hub 标记文件 —— gws 靠它向上定位 hub 根目录，勿删。
created=$(date +%Y-%m-%d)
EOF

  # docs 独立 git 仓库
  if [ ! -d "$DOCS/.git" ]; then
    git -C "$DOCS" init -q 2>/dev/null && {
      printf '# 文档仓库\n\n由 gws 管理，每个需求一个 <日期>-<需求名>/ 目录。\n' > "$DOCS/README.md"
      git -C "$DOCS" add -A 2>/dev/null
      git -C "$DOCS" commit -q -m "初始化文档仓库" 2>/dev/null
    }
  fi

  echo
  ok "hub 已创建: ${B}$HUB${N}"
  echo "   环境分支: ${envs//,/ }   ${D}(其余按需 gws env add pre / dev2 / dev_tmp …)${N}"
  echo
  echo "  ${B}下一步${N}"
  echo "    1. 添加仓库:  ${B}cd $HUB && gws repo add <git地址>${N}   ${D}(可多个)${N}"
  echo "    2. 同步环境:  ${B}gws sync${N}                            ${D}(建 envs worktree)${N}"
  echo "    3. 建需求:    ${B}gws new <需求名>${N}"
  echo "       或拉他人需求: ${B}gws get <feature分支名>${N}"
}

cmd_migrate() {
  require_hub
  local target="${1:-}"; shift || true
  local mode="move"
  while [ $# -gt 0 ]; do case "$1" in
    --move)  mode="move";  shift;;
    --clone) mode="clone"; shift;;
    *) die "未知参数: $1  ${D}(--move|--clone)${N}";;
  esac; done
  [ -n "$target" ] || die "用法: gws migrate <新hub目录> [--move|--clone]
     ${D}--move (默认) 直接移动 repos 目录，快；--clone 按 remote 重新 clone，最干净${N}
     ${D}ws/ 下的需求工作区不迁移（它们绑定旧 hub 的 worktree 元数据）${N}"

  target="${target/#\~/$HOME}"
  [ -e "$target/.gws-hub" ] && die "目标已是 hub: $target"
  local old_hub="$HUB"

  # 有活跃工作区时警告：worktree 元数据指向旧 hub，迁移后失效
  local live=(); [ -d "$WS" ] && for w in "$WS"/*/; do
    [ -f "$w/.workspace.json" ] && live+=("$(basename "${w%/}")")
  done
  if [ ${#live[@]} -gt 0 ]; then
    warn "以下需求工作区不会被迁移: ${live[*]}"
    echo "     ${D}它们的 worktree 绑定旧 hub。迁移后如仍需要，在新 hub 用 gws get <分支> 重新拉取${N}"
    if [ "$mode" = "move" ]; then
      echo "     ${D}--move 会移走 repos/，旧 hub 的这些工作区将直接失效${N}"
    fi
    if [ -t 0 ]; then
      echo; read -rp "  继续? [y/N] " a
      case "$a" in y|Y) ;; *) die "已取消";; esac
    fi
  fi

  mkdir -p "$target"/{repos,envs,ws,docs/_archive} || die "创建目录失败: $target"
  # 沿用旧 hub 的环境划分（只建空目录，worktree 由 gws sync 补）
  local old_envs; old_envs="$(all_envs)"
  for e in $old_envs; do mkdir -p "$target/envs/$e"; done
  printf '# gws hub 标记文件 —— gws 靠它向上定位 hub 根目录，勿删。\ncreated=%s\n' \
    "$(date +%Y-%m-%d)" > "$target/.gws-hub"

  echo
  info "迁移仓库 ($mode)"
  local n=0 fail=()
  for p in $(all_repos); do
    if [ "$mode" = "move" ]; then
      # 先清掉旧 worktree 元数据，避免带着失效引用搬家
      git -C "$REPOS/$p" worktree list --porcelain 2>/dev/null \
        | sed -n 's/^worktree //p' | grep -v "^$REPOS/$p\$" | while read -r wt; do
          git -C "$REPOS/$p" worktree remove --force "$wt" 2>/dev/null
        done
      git -C "$REPOS/$p" worktree prune 2>/dev/null
      mv "$REPOS/$p" "$target/repos/$p" && { echo "  ${G}✓${N} $p"; n=$((n+1)); } \
        || fail+=("$p")
    else
      local url; url=$(git -C "$REPOS/$p" remote get-url origin 2>/dev/null)
      [ -n "$url" ] || { fail+=("$p: 无 origin"); continue; }
      if git clone -q "$url" "$target/repos/$p" 2>/dev/null; then
        echo "  ${G}✓${N} $p"; n=$((n+1))
      else fail+=("$p: clone 失败"); fi
    fi
  done

  # 文档整体搬过去（docs 是独立 git 仓库，直接移动即可）
  if [ -d "$DOCS" ]; then
    rm -rf "$target/docs"
    cp -R "$DOCS" "$target/docs" 2>/dev/null && ok "文档已复制 ${D}(旧 hub 保留一份)${N}"
  fi

  [ ${#fail[@]} -gt 0 ] && { echo; warn "失败: ${fail[*]}"; }
  echo
  ok "已迁移 $n 个仓库到: ${B}$target${N}"
  echo
  echo "  ${B}下一步${N}"
  echo "    ${B}cd $target && gws sync${N}    ${D}(补建 envs worktree)${N}"
  if [ "$mode" = "move" ]; then echo "    ${D}旧 hub 的 repos/ 已搬空，确认新 hub 正常后可删除: $old_hub${N}"; fi
}

# ══ repo：仓库管理 ════════════════════════════════════════════════════
cmd_repo() {
  require_hub
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    add)
      [ $# -gt 0 ] || die "用法: gws repo add <git地址>...   ${D}(可一次多个)${N}"
      local added=0
      for url in "$@"; do
        # 从 url 推仓库名：去掉 .git 后缀取最后一段
        local name; name="$(basename "${url%.git}")"
        [ -n "$name" ] || { warn "无法解析仓库名: $url"; continue; }
        if [ -d "$REPOS/$name" ]; then warn "$name: 已存在，跳过"; continue; fi
        info "clone $name"
        if git clone -q "$url" "$REPOS/$name"; then
          ok "$name"; added=$((added+1))
        else
          warn "$name: clone 失败"; rm -rf "$REPOS/$name"
        fi
      done
      if [ "$added" -gt 0 ]; then
        echo; echo "  ${D}补建 envs worktree: ${B}gws sync${N}"
      fi;;
    ls)
      local n=0
      printf "%-40s %s\n" "仓库" "主干"
      for p in $(all_repos); do
        printf "%-40s ${D}%s${N}\n" "$p" "$(main_branch "$p")"
        n=$((n+1))
      done
      [ "$n" = 0 ] && echo "${D}(暂无仓库，用 gws repo add <git地址> 添加)${N}" \
        || echo "${D}共 $n 个${N}";;
    rm|remove)
      [ $# -gt 0 ] || die "用法: gws repo rm <仓库名>..."
      for p in "$@"; do
        [ -d "$REPOS/$p" ] || { warn "$p: 不存在"; continue; }
        # 该仓库若仍被工作区/envs 使用则拒删
        local used=()
        for w in "$WS"/*/; do
          [ -d "$w/$p" ] && used+=("ws/$(basename "${w%/}")")
        done
        if [ ${#used[@]} -gt 0 ]; then
          warn "$p: 仍被使用中: ${used[*]}，先 gws rm 或 gws drop"; continue
        fi
        for e in $(all_envs); do
          [ -d "$ENVS/$e/$p" ] && git -C "$REPOS/$p" worktree remove --force "$ENVS/$e/$p" 2>/dev/null
        done
        rm -rf "$REPOS/$p" && ok "$p 已移除"
      done;;
    *) die "用法: gws repo add <git地址>... | ls | rm <仓库名>...";;
  esac
}

# ══ env：环境分支管理（不再硬编码 dev/pre）════════════════════════════
cmd_env() {
  require_hub
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    add)
      [ $# -gt 0 ] || die "用法: gws env add <环境分支>...   ${D}(如 dev1、pre2、dev_tmp)${N}"
      prune_all_repos
      local fail=()
      for e in "$@"; do
        # 环境分支名按 git 规则校验（check-ref-format --branch）：大小写/中文均可，
        # 仅拒绝 git 本身不接受的形态（..、@{、尾空格/斜杠、control 字符等）
        if ! git check-ref-format --branch "$e" >/dev/null 2>&1; then
          fail+=("$e: 不是合法的 git 分支名"); continue
        fi
        [ -d "$ENVS/$e" ] && { warn "$e: 已存在"; continue; }
        # 至少要有一个仓库存在该远程分支，否则多半是敲错了
        local found=0
        for p in $(all_repos); do
          git -C "$REPOS/$p" fetch --prune -q origin 2>/dev/null
          has_remote "$p" "$e" && { found=1; break; }
        done
        if [ "$found" = 0 ]; then
          warn "$e: 所有仓库的远程都没有该分支"
          if [ -t 0 ]; then
            read -rp "     仍要创建? [y/N] " a
            case "$a" in y|Y) ;; *) continue;; esac
          else
            # 非交互（GUI 管道）不能静默跳过——调用方会误以为创建成功
            fail+=("$e: 远程无该分支"); continue
          fi
        fi
        mkdir -p "$ENVS/$e"
        local n=0
        for p in $(all_repos); do
          has_remote "$p" "$e" || continue
          if git -C "$REPOS/$p" rev-parse --verify -q "refs/heads/$e" >/dev/null 2>&1; then
            git -C "$REPOS/$p" worktree add -q "$ENVS/$e/$p" "$e" 2>/dev/null || continue
          else
            git -C "$REPOS/$p" worktree add -q -b "$e" "$ENVS/$e/$p" "origin/$e" 2>/dev/null || continue
          fi
          n=$((n+1))
        done
        if [ "$n" = 0 ]; then
          rmdir "$ENVS/$e" 2>/dev/null
          fail+=("$e: 没有任何模块创建成功")
          continue
        fi
        ok "$e 已创建 ${D}($n 个模块)${N}"
      done
      if [ ${#fail[@]} -gt 0 ]; then
        echo; warn "以下环境未创建成功:"; printf "     %s\n" "${fail[@]}"; return 1
      fi;;
    rm|remove)
      [ $# -gt 0 ] || die "用法: gws env rm <环境分支>..."
      for e in "$@"; do
        [ -d "$ENVS/$e" ] || { warn "$e: 不存在"; continue; }
        # 未推送的合并成果会随 worktree 一起没，先查一遍
        local risky=()
        for p in $(all_repos); do
          local wt="$ENVS/$e/$p"; [ -d "$wt" ] || continue
          local n; n=$(git -C "$wt" rev-list --count "origin/$e..HEAD" 2>/dev/null || echo 0)
          [ "${n:-0}" != "0" ] && risky+=("$p: $n 个提交未推送")
        done
        if [ ${#risky[@]} -gt 0 ]; then
          warn "$e: 存在未推送的合并成果:"; printf "     %s\n" "${risky[@]}"
          if [ -t 0 ]; then
            read -rp "     仍要移除? [y/N] " a
            case "$a" in y|Y) ;; *) continue;; esac
          else
            echo "     ${D}先 gws merge $e --push，或交互模式确认${N}"; continue
          fi
        fi
        for p in $(all_repos); do
          [ -d "$ENVS/$e/$p" ] && git -C "$REPOS/$p" worktree remove --force "$ENVS/$e/$p" 2>/dev/null
          git -C "$REPOS/$p" worktree prune 2>/dev/null
        done
        rm -rf "${ENVS:?}/$e"
        ok "$e 已移除"
      done;;
    ls)
      local any=0
      echo "${B}环境分支${N}   ${D}(即 envs/ 下的目录，gws env add/rm 增删)${N}"
      for e in $(all_envs); do
        any=1
        local n; n=$(ls -d "$ENVS/$e"/*/ 2>/dev/null | wc -l | tr -d ' ')
        if [ "$n" = 0 ]; then
          echo "  ${D}○${N} $e  ${D}(无模块，跑 gws sync)${N}"
        else
          echo "  ${G}●${N} $e  ${D}($n 个模块)${N}"
        fi
      done
      if [ "$any" = 0 ]; then echo "  ${D}(暂无环境，用 gws env add dev pre 创建)${N}"; fi;;
    *) die "用法: gws env add <环境>... | rm <环境>... | ls";;
  esac
}

# ══ get：拉取他人（或其他电脑）已推到远程的需求 ════════════════════════
cmd_get() {
  require_hub
  local branch="${1:-}"; shift || true
  local name="" title=""
  while [ $# -gt 0 ]; do case "$1" in
    --name|-n)  name="$2";  shift 2;;
    --title|-t) title="$2"; shift 2;;
    *) die "未知参数: $1  ${D}(--name <本地工作区名> | --title \"标题\")${N}";;
  esac; done
  [ -n "$branch" ] || die "用法: gws get <远程feature分支> [--name <工作区名>] [--title \"标题\"]
     ${D}用于拉取同事/其他电脑已推送的需求分支${N}"
  validate_ws_name "$branch" "分支"

  # 工作区名默认从分支名反推：<前缀>-YYYYMMDD-<名称> → <名称>
  # 兼容 feature- / hotfix- 等任意前缀；无法识别则直接用完整分支名
  if [ -z "$name" ]; then
    name="$(echo "$branch" | sed -n 's/^[a-zA-Z]\{1,\}-[0-9]\{8\}-\(.*\)$/\1/p')"
    [ -n "$name" ] || name="$branch"
  fi
  validate_ws_name "$name" "工作区"
  local dir="$WS/$name"
  [ -e "$dir" ] && die "本地已存在工作区: $name  ${D}(改名拉取: --name <别的名字>)${N}"

  info "扫描各仓库是否存在 origin/$branch"
  local mods=()
  for p in $(all_repos); do
    git -C "$REPOS/$p" fetch --prune -q origin 2>/dev/null
    has_remote "$p" "$branch" && mods+=("$p")
  done
  [ ${#mods[@]} -gt 0 ] || die "没有任何仓库存在远程分支 $branch
     ${D}确认分支名，或先 gws sync 刷新远程引用${N}"
  echo "  ${D}命中 ${#mods[@]} 个模块${N}"

  local docdir; docdir="$(date +%Y-%m-%d)-$name"
  mkdir -p "$dir" "$DOCS/$docdir"
  local created=()
  for m in "${mods[@]}"; do
    # 本地已有同名分支就直接复用，否则从 origin 建并绑定 upstream
    if git -C "$REPOS/$m" show-ref --verify -q "refs/heads/$branch"; then
      git -C "$REPOS/$m" worktree add -q "$dir/$m" "$branch" 2>/dev/null \
        && created+=("$m") && echo "  ${G}✓${N} $m ${D}(复用本地分支)${N}"
    else
      if git -C "$REPOS/$m" worktree add -q -b "$branch" "$dir/$m" "origin/$branch" 2>/dev/null; then
        # 协作场景：upstream 就该指向 origin/<feature>，方便 IDE 直接 pull/push
        git -C "$dir/$m" branch --set-upstream-to="origin/$branch" >/dev/null 2>&1
        created+=("$m"); echo "  ${G}✓${N} $m"
      else
        warn "$m: worktree 创建失败"
      fi
    fi
  done
  [ ${#created[@]} -gt 0 ] || { rmdir "$dir" 2>/dev/null; die "没有任何模块拉取成功"; }

  ln -sfn "../../docs/$docdir" "$dir/docs"
  local mj; mj=$(printf '"%s", ' "${created[@]}"); mj="[${mj%, }]"
  title="${title:-$name}"
  cat > "$dir/.workspace.json" <<EOF
{
  "name": "$name",
  "title": "$title",
  "branch": "$branch",
  "base": "远程拉取",
  "created": "$(date +%Y-%m-%d)",
  "stage": "dev",
  "modules": $mj,
  "docs": "$docdir",
  "merged": { "dev": null, "pre": null, "main": null }
}
EOF
  cat > "$dir/CLAUDE.md" <<EOF
# $title

> 工作区 \`$name\` · 分支 \`$branch\` · **从远程拉取（协作需求）**

## 涉及模块
$(printf -- "- %s\n" "${created[@]}")

## 约定
- 本目录下**只有**本需求会改动的模块，检索范围即为改动范围。
- 每个模块目录固定在 \`$branch\` 分支，**不要切分支**。
- 协作中：开工前先 \`gws pull\` 拉同事的最新提交，避免分叉。
- 合并 dev/pre 用 \`gws merge dev\`，不要手工在此目录合。
EOF

  echo
  ok "已拉取需求: ${B}$dir${N}"
  echo "   分支: $branch  ${D}(upstream 已绑定 origin/$branch)${N}"
  echo "   模块: ${created[*]}"
  echo
  echo "   ${D}开工前同步同事最新代码: ${B}gws pull${N}"
  echo "   ${D}下一步: cd $dir${N}"
}

# ══ pull：协作场景同步同一 feature 分支上同事的提交 ════════════════════
cmd_pull() {
  require_hub
  local dir; dir="$(cur_ws)"
  local f="$dir/.workspace.json" branch; branch="$(jget "$f" branch)"
  local rebase=0
  for a in "$@"; do case "$a" in
    --rebase) rebase=1;;
    *) die "未知参数: $a  ${D}(--rebase)${N}";;
  esac; done

  local conflict=() updated=() dirty=() skipped=()
  for m in $(jarr "$f" modules); do
    [ -d "$dir/$m" ] || continue
    git -C "$REPOS/$m" fetch --prune -q origin 2>/dev/null
    if ! git -C "$REPOS/$m" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      skipped+=("$m: 远程无 $branch"); continue
    fi
    # 落后为 0 就没必要动
    local behind; behind=$(git -C "$dir/$m" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)
    [ "${behind:-0}" = "0" ] && continue

    local n; n=$(git -C "$dir/$m" status --porcelain | wc -l | tr -d ' ')
    if [ "$n" != "0" ]; then dirty+=("$m: $n 个未提交改动"); continue; fi

    if [ "$rebase" = 1 ]; then
      git -C "$dir/$m" rebase -q "origin/$branch" >/dev/null 2>&1 \
        && updated+=("$m ($behind 个提交)") || conflict+=("$m")
    else
      git -C "$dir/$m" merge -q --no-edit "origin/$branch" >/dev/null 2>&1 \
        && updated+=("$m ($behind 个提交)") || conflict+=("$m")
    fi
  done

  [ ${#updated[@]} -gt 0 ] && { echo; echo "${G}已更新:${N}"; printf "  ✓ %s\n" "${updated[@]}"; }
  [ ${#skipped[@]} -gt 0 ] && { echo; echo "${Y}跳过:${N}"; printf "  - %s\n" "${skipped[@]}"; }
  if [ ${#dirty[@]} -gt 0 ]; then
    echo; warn "以下模块有未提交改动，未拉取:"; printf "     %s\n" "${dirty[@]}"
    echo "     ${D}先提交或 stash，再跑 gws pull${N}"
  fi
  if [ ${#conflict[@]} -gt 0 ]; then
    echo; echo "${R}冲突待处理 (${#conflict[@]}):${N}"
    for m in "${conflict[@]}"; do
      echo "  ${R}✗${N} $m"
      git -C "$dir/$m" diff --name-only --diff-filter=U 2>/dev/null | sed 's/^/      /'
      echo "      ${D}$dir/$m${N}"
    done
    echo; echo "  ${D}在 IDE 中解决冲突后 Commit 即可（就在工作区内，不用回 envs）${N}"
    return 1
  fi
  [ ${#updated[@]} -eq 0 ] && [ ${#dirty[@]} -eq 0 ] && ok "已是最新，无需更新"
  return 0
}

cmd_version() {
  echo "gws $GWS_VERSION  ${D}(github.com/$GWS_REPO)${N}"
}

cmd_update() {
  local self; self="$(gws_self_path)"
  info "当前版本: $GWS_VERSION  ${D}位于 $self${N}"
  [ -w "$self" ] || die "无写权限: $self  ${D}(需 sudo 或 chmod u+w)${N}"
  local tmp; tmp="$(mktemp)"
  # raw.githubusercontent.com 在国内网络下时常连不上，故依次尝试多个源。
  # 用户自设了 GWS_UPDATE_URL（自有镜像）则只用他指定的，不静默换源。
  local srcs=("$GWS_UPDATE_URL")
  if [ "$GWS_UPDATE_URL" = "$GWS_DEFAULT_URL" ]; then
    srcs+=("https://cdn.jsdelivr.net/gh/$GWS_REPO@main/gws"
           "https://ghproxy.net/https://raw.githubusercontent.com/$GWS_REPO/main/gws")
  fi
  local got=0 s
  for s in "${srcs[@]}"; do
    if curl -fsSL --connect-timeout 10 --max-time 60 --retry 2 --retry-delay 1 "$s" -o "$tmp" 2>/dev/null \
       && [ -s "$tmp" ]; then
      got=1; [ "$s" = "$GWS_UPDATE_URL" ] || info "主源不可达，已改用镜像 ${D}$s${N}"
      break
    fi
  done
  if [ "$got" = 0 ]; then
    rm -f "$tmp"
    die "拉取最新版本失败（已尝试 ${#srcs[@]} 个源）
     ${D}请检查网络，或设置 ${B}GWS_UPDATE_URL${N}${D} 指向可用镜像后重试${N}"
  fi
  # 下载内容须是 gws 脚本（防止仓库改版/返回 HTML 之类）
  grep -q '^GWS_VERSION=' "$tmp" || { rm -f "$tmp"; die "下载内容不是 gws 脚本，已中止（可能仓库结构变化）"; }
  local rv; rv="$(grep -m1 '^GWS_VERSION=' "$tmp" | cut -d= -f2 | tr -d '"')"; [ -n "$rv" ] || rv="未知"
  local oldh newh
  oldh="$(shasum -a 256 "$self" | awk '{print $1}')"
  newh="$(shasum -a 256 "$tmp" | awk '{print $1}')"
  if [ "$oldh" = "$newh" ]; then
    rm -f "$tmp"
    ok "已是最新: $GWS_VERSION"
    return 0
  fi
  chmod +x "$tmp"
  mv -f "$tmp" "$self"
  ok "已更新: $GWS_VERSION → $rv  ${D}重启终端后生效${N}"
  echo "   变更记录: https://github.com/$GWS_REPO/commits"
}

# ══ release：把本机脚本发布到 GitHub，供同事 gws update 拉取 ════════════
# 仅作者本人使用（需 gh 已登录且对仓库有写权限）。
# 流程：校验 → 算版本号 → clone → 拷脚本/README → 预览 → commit+push+tag → 回写本机版本号
cmd_release() {
  local bump="patch" newver="" note="" yes=0
  while [ $# -gt 0 ]; do case "$1" in
    --major)   bump="major"; shift;;
    --minor)   bump="minor"; shift;;
    --patch)   bump="patch"; shift;;
    --version) newver="$2"; shift 2;;
    --note|-m) note="$2"; shift 2;;
    --yes|-y)  yes=1; shift;;
    *) die "未知参数: $1  ${D}(--major|--minor|--patch|--version x.y.z|--note \"说明\"|--yes)${N}";;
  esac; done

  local self; self="$(gws_self_path)"
  command -v gh >/dev/null 2>&1 || die "需要 gh 命令  ${D}(brew install gh && gh auth login)${N}"
  gh auth status >/dev/null 2>&1 || die "gh 未登录  ${D}(gh auth login)${N}"

  # ── 维护者校验：发布是维护者专属操作 ──────────────────────────────
  # 即使他人绕过这里，push 也会因无仓库写权限被 GitHub 拒绝；此校验是为了
  # 让使用者一眼看清「这不是给我用的命令」，而不是失败在最后一步。
  local who; who="$(gh api user --jq .login 2>/dev/null)"
  if [ "$who" != "$GWS_MAINTAINER" ]; then
    die "gws release 仅限维护者（${GWS_MAINTAINER}）使用，当前账号: ${who:-未知}
     ${D}你要找的多半是: ${B}gws update${N}${D}（升级到最新版）${N}"
  fi

  [ -w "$self" ] || die "无写权限: $self"
  bash -n "$self" || die "脚本语法检查未通过，已中止发布"

  # 计算新版本号（默认 patch +1）
  if [ -z "$newver" ]; then
    local M m p
    M="$(echo "$GWS_VERSION" | cut -d. -f1)"
    m="$(echo "$GWS_VERSION" | cut -d. -f2)"
    p="$(echo "$GWS_VERSION" | cut -d. -f3)"
    case "$bump" in
      major) M=$((M+1)); m=0; p=0;;
      minor) m=$((m+1)); p=0;;
      patch) p=$((p+1));;
    esac
    newver="$M.$m.$p"
  fi
  case "$newver" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) die "版本号格式应为 x.y.z: $newver";;
  esac

  echo "${B}发布 gws${N}  $GWS_VERSION → ${G}$newver${N}"
  echo "   ${D}源:   $self${N}"
  echo "   ${D}仓库: github.com/$GWS_REPO${N}"

  local work; work="$(mktemp -d)"

  # 通过 GitHub API 提交文件，不走 git 传输通道。
  # 原因：部分网络下 api.github.com 可达而 github.com:443(git) 被阻断，
  # clone/push 会 75 秒超时失败。API 方式只依赖 gh，稳定得多。
  # gh_put <本地文件> <仓库内路径> —— 存在则更新(带 sha)，不存在则创建
  gh_put() {
    local src="$1" path="$2" sha="" b64
    sha="$(gh api "repos/$GWS_REPO/contents/$path" --jq .sha 2>/dev/null)"
    b64="$(base64 < "$src" | tr -d '\n')"
    local args=(-X PUT "repos/$GWS_REPO/contents/$path"
                -f "message=release $newver${note:+: $note}"
                -f "content=$b64")
    [ -n "$sha" ] && args+=(-f "sha=$sha")
    gh api "${args[@]}" >/dev/null 2>&1
  }

  # 版本号写进待发布副本（远程成功后才回写本机，避免发布失败留下假版本号）
  sed "s/^GWS_VERSION=\".*\"/GWS_VERSION=\"$newver\"/" "$self" > "$work/gws"
  if ! grep -q "^GWS_VERSION=\"$newver\"" "$work/gws"; then
    rm -rf "$work"; die "版本号写入失败，已中止"
  fi

  # README 取 hub 内的规范文档
  local rd=""
  [ -n "$HUB" ] && [ -f "$HUB/docs/README.md" ] && rd="$HUB/docs/README.md"
  [ -z "$rd" ] && [ -f "$PWD/docs/README.md" ] && rd="$PWD/docs/README.md"
  [ -n "$rd" ] && { cp "$rd" "$work/README.md"; echo "   ${D}README ← $rd${N}"; } \
               || warn "未找到 docs/README.md，本次不更新说明文档"

  # 与远程比对，只发有变化的文件
  info "比对远程"
  local changed=() f
  for f in gws README.md; do
    [ -f "$work/$f" ] || continue
    local remote="$work/.remote-$f"
    if gh api "repos/$GWS_REPO/contents/$f" --jq .content 2>/dev/null | base64 -d > "$remote" 2>/dev/null; then
      cmp -s "$work/$f" "$remote" || changed+=("$f")
    else
      changed+=("$f")   # 远程还没有该文件
    fi
  done
  if [ ${#changed[@]} -eq 0 ]; then
    rm -rf "$work"; ok "内容与远程完全一致，无需发布"; return 0
  fi
  echo; echo "${B}将发布${N}  ${changed[*]}"
  echo

  if [ "$yes" = 0 ] && [ -t 0 ]; then
    read -rp "  确认发布 $newver? [y/N] " a
    case "$a" in y|Y) ;; *) rm -rf "$work"; die "已取消（本机脚本未改动）";; esac
  fi

  info "上传"
  for f in ${changed[@]+"${changed[@]}"}; do
    gh_put "$work/$f" "$f" || { rm -rf "$work"; die "上传失败: $f  ${D}(检查网络与仓库写权限)${N}"; }
    echo "   ${G}✓${N} $f"
  done

  # 打 tag（指向最新提交）；失败不阻断发布，tag 只是锦上添花
  local head_sha; head_sha="$(gh api "repos/$GWS_REPO/commits/main" --jq .sha 2>/dev/null)"
  if [ -n "$head_sha" ]; then
    gh api -X POST "repos/$GWS_REPO/git/refs" \
      -f "ref=refs/tags/v$newver" -f "sha=$head_sha" >/dev/null 2>&1 \
      && echo "   ${G}✓${N} tag v$newver" \
      || warn "tag v$newver 创建失败（可能已存在），不影响发布"
  fi

  # 远程发布成功 → 回写本机脚本版本号，保持与已发布版本一致
  cp "$work/gws" "$self" && chmod +x "$self"
  rm -rf "$work"

  echo; ok "已发布 ${G}$newver${N}"
  echo "   同事执行 ${B}gws update${N} 即可升级"
  echo "   ${D}https://github.com/$GWS_REPO${N}"
}

usage() {
  cat <<EOF
${B}gws${N} — git workspace，用 Git 管理需求工作空间${HUB:+   ${D}$HUB${N}}

  ${B}hub 管理${N}  ${D}(init/migrate 可在任意目录执行；其余命令需在 hub 内，或加 --hub <路径>)${N}
    gws init [目录] [--envs dev,pre]   创建标准 hub 目录结构(不指定目录则询问)
                                 (默认只建 dev 环境，其余用 gws env add 增加)
    gws migrate <新hub> [--move|--clone]  迁移到新 hub(默认 --move；不迁 ws/ 需求)
    gws repo add <git地址>...    clone 仓库到 repos/
    gws repo ls | rm <仓库名>... 列出 / 移除仓库
    gws env add <环境>...        增加环境分支(如 dev1、pre2、dev_tmp)
    gws env ls | rm <环境>...    列出 / 移除环境分支

  ${B}生命周期${N}
    gws new <名称> [--modules a,b,c] [--from ws:<需求>|<ref>] [--title "标题"]
                        (不写 --modules 则默认全部仓库)
                        默认分支 feature-YYYYMMDD-<名称>；紧急修复等可换前缀:
                          --prefix hotfix     → hotfix-YYYYMMDD-<名称>
                          --branch <完整分支名> → 完全自定义
    gws get <feature分支> [--name <工作区名>]
                        拉取同事/其他电脑已推送的需求到本地
    gws add <模块>...            中途增加模块
    gws drop [<模块>...]         移除模块；无参数则清理被直接删除目录的缺失模块
    gws ls                       列出所有工作区
    gws st                       当前工作区各模块状态
    gws rm <名称>... [--force]  删除工作区(文档自动归档，可一次删多个)
    gws rename <旧名> <新名>    工作区改名(名称/feature分支/docs目录一并处理)
                                 可加 [--branch <新分支名>] [--title \"新标题\"]
    gws done                     检查是否已全部并入主干

  ${B}合并发布${N}
    gws pull [--rebase]          拉取他人推到同一 feature 分支的提交(协作必备)
                                 协作顺序: gws pull → 改代码 → gws push → gws merge dev
    gws push                     推送所有模块的 feature 分支
    gws merge <环境>             合并到本地 envs/<环境>（不推、不询问）
                                 确认无误后再推送: gws merge dev --push
                                 冲突时: IDE 解决 → 再跑同一命令即收尾
    gws merge dev --push|--yes   合并并直接推送（--push 日常 review 后推送；--yes 给脚本/CI）
    gws merge dev --force        丢弃 envs 本地未推送的合并成果，从远程重新合
    gws sync-main [--from <ref>] 把远程最新合进当前需求
                                 默认取创建时基线(base)：主干 → origin/main；
                                 ws:上游(阶段依赖) → 上游分支；也可显式 --from 覆盖
                                 有未提交改动会先问一句再合（--yes 跳过询问）
    gws sync                     同步所有仓库主干与 envs

  ${B}文档${N}  ${D}(写入工作区内 docs/ 下的任意 .md，软链自动落位到 docs/<日期>-<需求>)${N}
    gws doc new <文件名>         新建带 frontmatter 的文档
    gws doc ls                   文档同步状态
    gws doc push [文件]          自动纳入 git 并上传 Confluence
    gws doc commit [说明]        把工作区 docs/ 新增/修改的文档纳入 git 仓库

  ${B}更新${N}
    gws version                 查看版本
    gws update                  从 GitHub 自更新（需 curl，可设 GWS_UPDATE_URL 覆盖源）
EOF
  # release 是维护者专属命令，仅在维护者本机显示（避免使用者误以为该自己发版）。
  # 标记文件由维护者自行创建：touch ~/.gws-maintainer
  if [ -f "$HOME/.gws-maintainer" ]; then
    cat <<EOF
    gws release [--patch|--minor|--major]
                                发布新版到 GitHub 供他人 update（维护者专属）
                                默认 patch 位 +1；也可 --version x.y.z --note "说明"
EOF
  fi
}

# ── 全局 --hub <路径>：从参数里摘出来，其余原样传给子命令 ──────────────
ARGS=(); _want_hub=""
for a in "$@"; do
  if [ -n "$_want_hub" ]; then _want_hub=""; set_hub "${a/#\~/$HOME}" 2>/dev/null \
    || die "--hub 路径无效: $a"; continue; fi
  case "$a" in
    --hub) _want_hub=1;;
    --hub=*) set_hub "${a#--hub=}" 2>/dev/null || die "--hub 路径无效: ${a#--hub=}";;
    *) ARGS+=("$a");;
  esac
done
[ -n "$_want_hub" ] && die "--hub 缺少路径参数"
if [ -n "$HUB" ] && [ ! -f "$HUB/.gws-hub" ]; then
  die "指定的目录不是 hub（缺 .gws-hub）: $HUB  ${D}(用 gws init 创建)${N}"
fi
set -- "${ARGS[@]:-}"

# init/migrate 可在任意目录执行；其余命令由 require_hub 兜底
case "${1:-}" in
  init)      shift; cmd_init "$@";;
  migrate)   shift; cmd_migrate "$@";;
  repo)      shift; cmd_repo "$@";;
  env)       shift; cmd_env "$@";;
  get)       shift; require_hub; cmd_get "$@";;
  pull)      shift; require_hub; cmd_pull "$@";;
  new)       shift; require_hub; cmd_new "$@";;
  add)       shift; require_hub; cmd_add "$@";;
  drop)      shift; require_hub; cmd_drop "$@";;
  ls)        shift; require_hub; cmd_ls "$@";;
  st|status) shift; require_hub; cmd_st "$@";;
  rm|remove) shift; require_hub; cmd_rm "$@";;
  rename)    shift; require_hub; cmd_rename "$@";;
  done)      shift; require_hub; cmd_done "$@";;
  push)      shift; require_hub; cmd_push "$@";;
  merge)     shift; require_hub; cmd_merge "$@";;
  sync-main) shift; require_hub; cmd_sync_main "$@";;
  sync)      shift; require_hub; cmd_sync "$@";;
  doc)       shift; require_hub; cmd_doc "$@";;
  update)    shift; cmd_update "$@";;
  version)   shift; cmd_version "$@";;
  release)   shift; _h="$(find_hub 2>/dev/null)"; [ -n "$_h" ] && set_hub "$_h"; cmd_release "$@";;
  ""|-h|--help|help) HUB="$(find_hub 2>/dev/null)"; usage;;
  *) die "未知命令: $1  ${D}(gws --help)${N}";;
esac
