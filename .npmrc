# 国内镜像。
# 注意：必须是 registry.npmmirror.com（带 registry. 前缀）。
# 写成 npmmirror.com 会打到网站首页，npm 拿到 HTML 就报
# "invalid json response body ... Unexpected token '<'"。
registry=https://registry.npmmirror.com

# vitest 4 的 peer 依赖树在 npm 10 上会触发 arborist 的
# "Cannot read properties of null (reading 'edgesOut')"，装不下去。
# 关掉 peer 校验即可绕过（本项目不依赖 peer 约束来保证正确性）。
legacy-peer-deps=true
